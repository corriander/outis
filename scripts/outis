#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
cd "${REPO_ROOT}"

# Compose derives a project name from the checkout directory unless told
# otherwise, so a clone into `outis-2` or a worktree silently becomes a second,
# competing deployment with its own containers and volumes. Varlock loads
# `.env.local` only for its child process, which is too late for this wrapper's
# `-p` argument. Read this one non-secret, literal setting up front so deploy,
# status, logs, inventory, and stop always address the same project without
# making read-only/operator commands resolve the deployment's secrets.
COMPOSE_PROJECT="${COMPOSE_PROJECT_NAME:-}"
if [ -z "${COMPOSE_PROJECT}" ] && [ -f .env.local ]; then
  compose_project_assignment="$({
    sed -nE 's/^[[:space:]]*(export[[:space:]]+)?COMPOSE_PROJECT_NAME[[:space:]]*=(.*)$/\2/p' \
      .env.local || true
  } | tail -n 1)"
  if [ -n "${compose_project_assignment}" ]; then
    COMPOSE_PROJECT="$(printf '%s\n' "${compose_project_assignment}" | sed -E \
      -e 's/[[:space:]]+#.*$//' \
      -e 's/^[[:space:]]+//' \
      -e 's/[[:space:]]+$//' \
      -e 's/^"([^"]*)"$/\1/' \
      -e "s/^'([^']*)'$/\1/")"
  fi
fi
COMPOSE_PROJECT="${COMPOSE_PROJECT:-outis}"

if ! [[ "${COMPOSE_PROJECT}" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then
  echo "Invalid COMPOSE_PROJECT_NAME: ${COMPOSE_PROJECT}" >&2
  exit 2
fi

usage() {
  cat <<'EOF'
Usage: ./scripts/outis <command> [options]

Commands:
  deploy      Validate config, pull the published image, and recreate the
              Outis container
                --build   Build the image from this checkout instead of
                          pulling the published one
  restart     Restart the existing Outis container without rebuilding.
              Starts the project's dependencies first if they are down
  status      Show the status of every container in the project
  logs        Follow recent Outis logs
  inventory   Exercise the configured ArtifactStore through the Outis client
  config      Validate and display the redacted Varlock configuration
  stop        Stop every container in the project. Containers are preserved,
              not removed; `deploy` and `restart` bring them back

This is the deployment surface for standalone Outis deployments. If an
external control plane or orchestrator manages this deployment, use that
plane's operator surface instead of this script.
EOF
}

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Required command not found: $1" >&2
    exit 127
  fi
}

compose() {
  docker compose -p "${COMPOSE_PROJECT}" "$@"
}

command="${1:-}"
case "${command}" in
  deploy)
    require_command varlock
    require_command docker
    shift
    build_from_source=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --build)
          build_from_source=1
          shift
          ;;
        *)
          echo "Unknown option for deploy: $1" >&2
          usage >&2
          exit 2
          ;;
      esac
    done

    if [ "${build_from_source}" -eq 1 ]; then
      # Source build: tags the local image as ghcr.io/corriander/outis:$OUTIS_TAG
      # (the `image:` key in docker-compose.yml), so it shadows the published
      # artefact under that tag until the next pull.
      exec varlock run --no-inject-graph -- \
        docker compose -p "${COMPOSE_PROJECT}" up -d --build --force-recreate odysseus
    fi

    # Default: deploy the published artefact. Pull and up run under a single
    # Varlock resolution so secrets are fetched once.
    exec varlock run --no-inject-graph -- \
      bash -c '
        docker compose "$@" pull odysseus &&
        docker compose "$@" up -d --force-recreate odysseus
      ' outis-deploy -p "${COMPOSE_PROJECT}"
    ;;
  restart)
    require_command docker
    # `stop` stops the whole project, so `restart` is now reachable with the
    # dependencies down. Restarting the application alone would leave it running
    # against a stopped search and vector store: up, reporting healthy, and
    # quietly missing capabilities.
    #
    # `up --no-recreate` starts whatever is down and leaves a running container
    # untouched, so this still neither builds nor recreates. Dependencies and
    # their healthcheck gate come from the compose file rather than a hardcoded
    # service list here.
    was_running="$(docker compose -p "${COMPOSE_PROJECT}" ps -q --status=running odysseus)"
    docker compose -p "${COMPOSE_PROJECT}" up -d --no-recreate odysseus
    # Only bounce the application if it was already up. When `up` had to start
    # it, it is already freshly started and restarting it again would just cost
    # another startup.
    if [ -n "${was_running}" ]; then
      exec docker compose -p "${COMPOSE_PROJECT}" restart odysseus
    fi
    ;;
  status)
    require_command docker
    # Report the project for the same reason `stop` targets it: reporting the
    # application service alone implied the application was the deployment.
    exec docker compose -p "${COMPOSE_PROJECT}" ps
    ;;
  logs)
    require_command docker
    exec docker compose -p "${COMPOSE_PROJECT}" logs --tail=200 -f odysseus
    ;;
  inventory)
    require_command docker
    compose exec -T odysseus python - <<'PY'
import asyncio

from artifact_store.client import ArtifactStoreClient


async def main() -> None:
    client = ArtifactStoreClient.from_env()
    if client is None:
        raise SystemExit("ArtifactStore is not configured in the Outis container")
    document = await client.list_artifacts()
    provider = document.get("provider") or {}
    status = document.get("status") or {}
    artifacts = document.get("artifacts") or []
    name = provider.get("name") or provider.get("id") or "unknown"
    print(f"provider={name} state={status.get('state', 'unknown')} artifacts={len(artifacts)}")


asyncio.run(main())
PY
    ;;
  config)
    require_command varlock
    exec varlock load
    ;;
  stop)
    require_command docker
    # Address the project, not the application service. Stopping only `odysseus`
    # left the search, vector-store, and notification containers running while
    # the operator believed the deployment was down.
    #
    # `stop`, deliberately, not `down`: containers and their state are preserved,
    # which is what `deploy` and `restart` already assume. Removing them is a
    # different promise and is not made here.
    exec docker compose -p "${COMPOSE_PROJECT}" stop
    ;;
  -h|--help|help|"")
    usage
    ;;
  *)
    echo "Unknown command: ${command}" >&2
    usage >&2
    exit 2
    ;;
esac
