# @plugin(@varlock/1password-plugin@2.0.3)
# @initOp(allowAppAuth=true)
# ---
#
# Outis deployment configuration.
#
# Commit validation, defaults, and documentation here. Put machine-specific
# values and secret-manager resolvers in the ignored `.env.local` file.

# Compose project name. Pinned so a clone or worktree under a different
# directory name addresses the same deployment instead of silently creating a
# second one with its own containers and volumes.
# @type=string
COMPOSE_PROJECT_NAME=outis

# Published image tag pulled by `./scripts/outis deploy`. `latest` is the newest
# release; pin a specific released version (e.g. 0.1.0) for a reproducible
# deployment, or use `main` to track the tip of main.
# @type=string
OUTIS_TAG=latest

# @type=string
OUTIS_COOKBOOK_MODE=native

# External ArtifactStore base URL, without the `/v1/artifacts` suffix.
# @optional @type=url
OUTIS_ARTIFACT_STORE_URL=

# Human-readable provider name displayed in the Cookbook.
# @type=string
OUTIS_ARTIFACT_STORE_NAME=external-artifact-store

# Shared bearer token used only for calls from Outis to the ArtifactStore.
# Resolve this from a secret manager in `.env.local`; never store the value here.
# @optional @sensitive @type=string(minLength=32)
OUTIS_ARTIFACT_STORE_TOKEN=

# @type=number(min=0.5, max=60)
OUTIS_ARTIFACT_STORE_TIMEOUT=10

# External ProfileService base URL, without the `/v1/profiles` suffix. Selected
# independently of the ArtifactStore: pointing both at one endpoint is a valid
# deployment, but configuring either never configures the other.
# @optional @type=url
OUTIS_PROFILE_SERVICE_URL=

# Human-readable provider name displayed in the Cookbook.
# @type=string
OUTIS_PROFILE_SERVICE_NAME=external-profile-service

# Shared bearer token used only for calls from Outis to the ProfileService. It
# never reaches the browser. Resolve this from a secret manager in `.env.local`;
# never store the value here.
# @optional @sensitive @type=string(minLength=32)
OUTIS_PROFILE_SERVICE_TOKEN=

# @type=number(min=0.5, max=60)
OUTIS_PROFILE_SERVICE_TIMEOUT=10

# Docker web binding. Keep loopback unless exposure is intentional.
# @type=string
APP_BIND=127.0.0.1

# @type=port
APP_PORT=7000

# @type=boolean
AUTH_ENABLED=true

# Include PDF/Office extraction dependencies in the Docker image.
# @type=boolean
INSTALL_OPTIONAL=false

# Optional pre-seeded administrator password.
# @optional @sensitive @type=string
ODYSSEUS_ADMIN_PASSWORD=
